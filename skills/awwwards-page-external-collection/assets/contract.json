  "acceptance": [
    "按明确的即时筛选与完整目录查询发现商品，并可靠继续浏览、查看信息和返回。",
    "查询失败不表示零结果；旧请求不得覆盖新选择，加载更多失败保留卡片与游标；无脚本和数据失败可读取全部原创商品信息。",
    "筛选结果依靠可读数量和状态传达；抽屉可键盘关闭并恢复焦点，移动重排不遮挡核心控件。",
    "320、390、768、1440 宽度不出现整页横溢出；必要表格在独立区域滚动。",
    "键盘可进入、操作、关闭对话框并返回触发点；错误不只靠颜色。",
    "本地预览不得暗示真实支付、投稿、消息、账户或预约已生效。",
    "即时筛选不等待关闭才更新；Esc/关闭保留已确认选择，显示结果后有明确焦点落点。",
    "数量来自完整查询；失败不可冒充空结果，待定选择与已确认结果有可读区分。",
    "同类多选 OR、维度之间 AND；选项数量口径明确，过期响应不能覆盖较新筛选。",
    "加载更多保留卡片与游标；返回商品列表恢复查询、排序、展开位置与触发焦点。",
    "无脚本与数据失败保留全部原创商品信息；价格未知不显示为零，原站资产与真实库存不随包交付。"
  ],
  "limitations": [
    "Source interaction audit is not automatically performed",
    "Source assets are not bundled",
    "Real backend, production and physical-device acceptance are not included"
  ],
  "collection_contract": {
    "implementation": "Eighteen original fictional objects with CSS illustrations, complete static descriptions and local asynchronous queries",
    "filter_timing": "Live: selection triggers query while drawer remains open; Show objects closes without discarding confirmed filters",
    "query_scope": "Full original catalog, not just currently loaded cards; OR within category, AND across dimensions",
    "facet_counts": "Each dimension excludes its own selection while respecting search and other dimensions",
    "confirmed_state": "URL and counts represent confirmed results; failure preserves previous confirmed cards and offers retry or restore",
    "cursor": "Bound to catalog content revision and normalized query; not an authorization token",
    "unknown_values": "Unknown price stays null and sorts after known prices in both directions; availability unknown is distinct from unavailable",
    "reading_return": "Restore query, sort, shown position, origin focus and scroll",
    "static_editing": "After catalog.json edits, run python render_static.py in the exported template and repeat validation",
    "source_boundaries": [
      "Reported source counts are not a full stock audit",
      "Normal query-result read POST was permitted only for native anonymous filter UI; other POSTs remained blocked",
      "Source pagination, exhaustive combinations and purchase states untested"
    ]
  }
