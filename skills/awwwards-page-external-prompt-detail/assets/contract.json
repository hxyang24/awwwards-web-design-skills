  "id": "external-prompt-detail",
  "skill": "awwwards-page-external-prompt-detail",
  "title": "获奖来源外站提示词与字体效果详情",
  "kind": "prompt",
  "scope": "Awwwards-linked external inner page; specific award status requires official evidence",
  "source_families": [
    "external.prompt-detail"
  ],
  "goal": "审阅并编辑分层提示词，理解样例来源并可靠复制原创配方。",
  "regions": [
    "效果身份",
    "文字输入",
    "分层配方",
    "复制与失败恢复",
    "结果对比",
    "解释与服务边界"
  ],
  "workflow": [
    "把用户文字、字形描述和场景描述分成可检查的层，保留 Unicode 和文本方向，不把图像提示词称作可安装字体。",
    "编辑时更新本地组合文本；复制必须等待剪贴板实际成功，拒绝时提供选中和手动复制。",
    "结果切换使用可访问选项卡或对比视图；模型结果必须来自真实记录，原创 CSS 示意不冒充模型基准。",
    "生成入口与配方编辑分开；接入前确认提供者、费用、发送内容和素材许可，未接入时不宣称生成成功。"
  ],
  "data_fields": [
    "exact_text",
    "letterform_layer",
    "scene_layer",
    "composed_prompt",
    "direction",
    "clipboard_status",
    "result_provenance",
    "provider_boundary"
  ],
  "failure_recovery": "空文字、长度超限和剪贴板拒绝有可恢复提示；任何失败不丢失已编辑配方。",
  "motion_contract": "移动端分层内容可折叠并保留完整可选文本；查看器、选项卡和关闭都有键盘路径。",
  "evidence_level": "rendered_source_observations",
  "source_relationship_note": "An outbound work-detail association does not certify that every current inner page won an award or matches a historical version.",
  "evidence_note": "Only recorded observations are facts. DOM structure does not prove visual composition, hidden state, source code, backend behavior or licenses. The runnable blueprint is an original recipe, not a source-site clone.",
