  "skill": "awwwards-page-website-explorer",
  "title": "作品探索与多维筛选",
  "kind": "listing",
  "scope": "Awwwards main-site page family",
  "source_families": [
    "main.website-explorer",
    "main.category-list"
  ],
  "goal": "帮助用户在完整结果中定位条目，并进入详情或恢复空结果。",
  "regions": [
    "页面标题",
    "分类导航",
    "当前筛选",
    "排序",
    "作品卡片",
    "结果数量",
    "分页"
  ],
  "workflow": [
    "将行业、风格、交互、技术建为独立筛选维度，不互相混作事实。",
    "切换条件后复位页码并保留可分享的查询状态。",
    "说明筛选针对全部结果还是当前页；空结果提供移除条件和重置。"
  ],
  "data_fields": [
    "facets",
    "selected_filters",
    "sort",
    "page",
    "total",
    "items[].award",
    "items[].source"
  ],
  "failure_recovery": "未知技术保留 unknown；不存在的组合显示空结果，不能自动撤销用户筛选。",
  "motion_contract": "筛选结果变化只做短暂定位反馈，保留焦点和滚动位置。",
  "evidence_level": "http_dom",
  "source_relationship_note": "An outbound work-detail association does not certify that every current inner page won an award or matches a historical version.",
  "evidence_note": "Only recorded observations are facts. DOM structure does not prove visual composition, hidden state, source code, backend behavior or licenses. The runnable blueprint is an original recipe, not a source-site clone.",
