  "goal": "理解计费周期和权益限制，再审阅明确的方案。",
  "regions": [
    "计费口径",
    "套餐与月费",
    "权益比较",
    "计算单位",
    "用量输入",
    "估算明细",
    "假设与恢复",
    "审阅"
  ],
  "workflow": [
    "把月费、资源费率和实际工作量的单位分别建模；切换单价展示不能改变工作量或最终估算。",
    "对请求数、运行时长、硬件及分配量给出明确精度和边界；小数、空值、负数或超限不能静默改写。",
    "逐项计算并公开舍入口径和未计成本；未知自定义月费时保留未知总价，已知用量可以单独显示。",
    "手机比较选项卡独立于估算套餐选择，提供键盘、宽屏表格和无脚本的全部内容。",
    "审阅显示当前有效估算及假设；本地蓝本不创建真实账户、报价、购买或订单。"
  ],
  "data_fields": [
    "tariff_version",
    "currency",
    "workspace_plan",
    "base_fee",
    "rate_unit",
    "requests_per_month",
    "active_seconds",
