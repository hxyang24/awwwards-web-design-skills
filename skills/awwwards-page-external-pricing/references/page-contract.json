  "acceptance": [
    "理解计费周期和权益限制，再审阅明确的方案。",
    "输入变化后旧估算不可冒充当前值；错误定位至相应字段并可恢复；源数据失败保留静态示例、全部套餐与单位说明。",
    "不依赖动效解释价格变化；单位切换只更新可读数值与说明，移动比较切换和断点重排保持焦点。",
    "320、390、768、1440 宽度不出现整页横溢出；必要表格在独立区域滚动。",
    "键盘可进入、操作、关闭对话框并返回触发点；错误不只靠颜色。",
    "本地预览不得暗示真实支付、投稿、消息、账户或预约已生效。",
    "单位切换不改变工作量或月度总额；月费与存储始终按月标记。",
    "小数不可静默删除或重新解释；错误可编辑恢复，旧估算在输入变化后失效。",
    "比较套餐与估算套餐独立；断点变化不能让焦点留在隐藏内容。",
    "未知月费不得显示为零或已知总额；无脚本和数据失败仍可读全部套餐与静态示例。"
  ],
  "limitations": [
    "Source interaction audit is not automatically performed",
    "Source assets are not bundled",
    "Real backend, production and physical-device acceptance are not included"
  ],
  "estimate_contract": {
    "implementation": "Original fictional tariff; never source provider prices or live billing",
    "amount_precision": "BigInt integer cents; aggregate each monthly component before half-up rounding",
    "runtime_precision": "Milliseconds, at most three decimal places",
    "display_basis": "Per second or per hour; changing display cannot change workload or total",
    "unknown_fee": "Preserve null base and total for custom workspace fees; known usage remains visible",
    "edit_policy": "Invalidate old estimate on edits; require recalculation before review",
    "limits": {
      "requests": 10000000,
      "active_seconds": 3600,
      "accelerators": 8,
      "vcpus": 64,
      "memory_gb": 256,
      "storage_gb": 100000
    },
    "excluded_costs": [
      "Tax",
      "Transfer",
      "Idle allocation",
      "Discounts and commitments",
      "Currency conversion"
    ]
  }
